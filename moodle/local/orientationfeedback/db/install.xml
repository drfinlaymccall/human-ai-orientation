<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="local/orientationfeedback/db" VERSION="20261023" COMMENT="Private orientation feedback" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../lib/xmldb/xmldb.xsd">
<TABLES><TABLE NAME="local_orientationfeedback" COMMENT="Private learner feedback">
<FIELDS>
<FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
<FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true"/>
<FIELD NAME="courseid" TYPE="int" LENGTH="10" NOTNULL="true"/>
<FIELD NAME="cmid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
<FIELD NAME="source" TYPE="char" LENGTH="80" NOTNULL="true" DEFAULT=""/>
<FIELD NAME="sectionlabel" TYPE="char" LENGTH="160" NOTNULL="true" DEFAULT=""/>
<FIELD NAME="message" TYPE="text" NOTNULL="true"/>
<FIELD NAME="submissiontoken" TYPE="char" LENGTH="32" NOTNULL="true"/>
<FIELD NAME="filename" TYPE="char" LENGTH="80" NOTNULL="true" DEFAULT=""/>
<FIELD NAME="mimetype" TYPE="char" LENGTH="80" NOTNULL="true" DEFAULT=""/>
<FIELD NAME="filesize" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
<FIELD NAME="notificationstate" TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="pending"/>
<FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true"/>
</FIELDS>
<KEYS><KEY NAME="primary" TYPE="primary" FIELDS="id"/><KEY NAME="user" TYPE="foreign" FIELDS="userid" REFTABLE="user" REFFIELDS="id"/><KEY NAME="course" TYPE="foreign" FIELDS="courseid" REFTABLE="course" REFFIELDS="id"/></KEYS>
<INDEXES><INDEX NAME="user-token" UNIQUE="true" FIELDS="userid,submissiontoken"/><INDEX NAME="course-time" UNIQUE="false" FIELDS="courseid,timecreated"/></INDEXES>
</TABLE></TABLES></XMLDB>
