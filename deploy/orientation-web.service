[Unit]
Description=Orientation application web server (loopback)
Requires=orientation-php.service
After=orientation-php.service

[Service]
ExecStart=/usr/bin/caddy run --config /home/finlay/apps/human-ai-orientation/deploy/Caddyfile --adapter caddyfile
# always: a clean stop (exit 0) must also restart. `systemctl --user stop` still stops it.
Restart=always
RestartSec=5
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=default.target
