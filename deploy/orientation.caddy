# Imported by the existing system Caddy. Other sites keep their own routes.
orientation.finlaymccall.com {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		# Caching is decided by the course web server (deploy/Caddyfile): public pages say no-store,
		# Moodle's versioned files keep Moodle's own caching.
		-Server
	}
	reverse_proxy 127.0.0.1:8789
}
