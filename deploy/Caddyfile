{
	admin off
	auto_https off
}

:8789 {
	bind 127.0.0.1
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		# The microphone and camera work for this site only: voice feedback, and Moodle's own editor recording.
		Permissions-Policy "microphone=(self), camera=(self), geolocation=(), payment=(), usb=()"
		-Server
	}
	# Two defaults, each in its own directive: in one block, Caddy applies defaults only when all of them are missing.
	# No other site may show these pages inside a frame. Moodle frames only its own pages.
	header ?Content-Security-Policy "frame-ancestors 'self'"
	# Public pages and their files are not cached, so a published change shows at once.
	# Moodle sets its own caching on its pages and versioned files; this default leaves those alone.
	header ?Cache-Control "no-store"
	# Search policy. Stage A (since 12 November 2026): noindex on everything except the public course pages.
	# To go back to the preview, where every response says noindex, change this one line to
	# `import robots-preview.caddy`. Both files are written by scripts/build-discovery.py. Finlay decides.
	import robots-stage-a.caddy
	request_body {
		max_size 16MB
	}
	@private {
		path_regexp private (^|/)(\.[^/]*|vendor|node_modules|tests|fixtures|behat|cli)(/|$)|(^|/)(config\.php|config-dist\.php|composer\.(json|lock)|package(-lock)?\.json|phpunit\.xml.*|README.*|UPGRADING.*|Gruntfile\.js|.*\.(md|txt|lock|dist|bak|sql|orig|old|save|swp)|.*~)$|^/install\.php$
		not path /ai/context.md /ai/releases/2026-10-13.1/context.md /ai/releases/2026-10-13.2/context.md /ai/releases/2026-10-13.3/context.md /ai/releases/2026-10-23.1/context.md /ai/releases/2026-10-23.2/context.md /ai/releases/2026-10-24.1/context.md /ai/releases/2026-10-24.2/context.md /ai/releases/2026-10-24.3/context.md /ai/releases/2026-10-25.1/context.md /ai/releases/2026-11-06.1/context.md /ai/releases/2026-11-10.1/context.md /downloads/orientation-practice.md /robots.txt
	}
	handle @private {
		respond "Not found" 404
	}
	redir /ai /ai/ 308
	# Old or mistyped forms of the public addresses go to the one real address.
	redir /index.html / 308
	redir /favicon.ico /assets/favicon.svg 308
	@alias path_regexp alias ^/(catalogue|agent-basics|desktop-workspace|journey|first-task|preview|portfolio|check-and-continue|before-you-start|notes|free-tools|deeper-courses|help)(\.html|/)$
	redir @alias /{re.alias.1} 308
	@discovery path /robots.txt /sitemap.xml
	handle @discovery {
		root * /home/finlay/apps/human-ai-orientation/public
		file_server
	}
	# The static recovery page is gone. Old links go to Moodle's own recovery form.
	@oldrecovery path /recovery /recovery.html
	redir @oldrecovery /login/forgot_password.php 302
	@aiPublic path /ai/ /ai/context.md /ai/course.json /ai/course.schema.json /ai/course.schema.v1.1.json /ai/course.schema.v1.2.json /ai/course.schema.v1.3.json /ai/course.schema.v1.4.json /ai/releases/2026-10-13.1/context.md /ai/releases/2026-10-13.2/context.md /ai/releases/2026-10-13.3/context.md /ai/releases/2026-10-23.1/context.md /ai/releases/2026-10-23.2/context.md /ai/releases/2026-10-24.1/context.md /ai/releases/2026-10-24.2/context.md /ai/releases/2026-10-24.3/context.md /ai/releases/2026-10-25.1/context.md /ai/releases/2026-11-06.1/context.md /ai/releases/2026-11-10.1/context.md
	handle @aiPublic {
		root * /home/finlay/apps/human-ai-orientation/public
		@aiMarkdown path /ai/context.md /ai/releases/*/context.md
		header @aiMarkdown Content-Type "text/plain; charset=utf-8"
		file_server
	}
	handle / {
		root * /home/finlay/apps/human-ai-orientation/public
		rewrite * /index.html
		file_server
	}
	@journey path /catalogue /agent-basics /desktop-workspace /course-introduction /journey /first-task /portfolio /check-and-continue /help
	handle @journey {
		root * /home/finlay/apps/human-ai-orientation/public
		rewrite * {path}.html
		file_server
	}
	handle /preview {
		root * /home/finlay/apps/human-ai-orientation/public
		rewrite * /preview.html
		file_server
	}
	handle /deeper-courses {
		root * /home/finlay/apps/human-ai-orientation/public
		rewrite * /deeper-courses.html
		file_server
	}
	handle /free-tools {
		root * /home/finlay/apps/human-ai-orientation/public
		rewrite * /free-tools.html
		file_server
	}
	handle /before-you-start {
		root * /home/finlay/apps/human-ai-orientation/public
		rewrite * /before-you-start.html
		file_server
	}
	handle /notes {
		root * /home/finlay/apps/human-ai-orientation/public
		rewrite * /notes.html
		file_server
	}
	handle /downloads/orientation-practice.md {
		root * /home/finlay/apps/human-ai-orientation/public
		header Content-Disposition "attachment; filename=orientation-practice.md"
		header Content-Type "text/plain; charset=utf-8"
		file_server
	}
	@privacy path /privacy /privacy.html
	handle @privacy {
		root * /home/finlay/apps/human-ai-orientation/public
		rewrite * /privacy.html
		file_server
	}
	handle /assets/* {
		root * /home/finlay/apps/human-ai-orientation/public
		file_server
	}
	# An address that is neither a public page nor anything in Moodle gets a real "not found" page.
	# Moodle addresses are files, folders, or a .php file followed by a path.
	@unknown {
		not path_regexp \.php(/|$)
		not file {
			root /home/finlay/apps/human-ai-orientation/trial/moodle
			try_files {path} {path}/
		}
	}
	handle @unknown {
		root * /home/finlay/apps/human-ai-orientation/public
		rewrite * /errors/not-found.html
		file_server {
			status 404
		}
	}
	handle {
		root * /home/finlay/apps/human-ai-orientation/trial/moodle
		php_fastcgi 127.0.0.1:8788 {
			# Moodle 4.5 recognises nginx FastCGI variables but not the Caddy name.
			# See lib/setuplib.php setup_get_remote_url(); no core files are patched.
			env SERVER_SOFTWARE nginx
			env HTTPS on
			env SERVER_PORT 443
		}
		file_server
	}
}
